#!/bin/sh

ENABLED=yes
PROCS=trojan
ARGS=""
PREARGS=""
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=/opt/etc/trojan/config.json
LOGFILE=/opt/var/log/trojan.log

[ -z "$(which $PROCS)" ] && exit 0

key_config_ready() {
    # A complete JSON can be a stale preserved config. Only a config written
    # through the key/config panel receives this explicit readiness marker.
    [ -f "/opt/etc/unblock/.configured/trojan" ] || return 1
    [ -s "$CONFIG" ] || return 1
    grep -q '{{' "$CONFIG" 2>/dev/null && return 1
    grep -qE '"(address|server|remote_addr|password|auth|id|publicKey)"[[:space:]]*:[[:space:]]*(""|\[[[:space:]]*""|\[\])' "$CONFIG" 2>/dev/null && return 1
    return 0
}

rotate_trojan_log() {
    mkdir -p /opt/var/log 2>/dev/null || true
    : >> "$LOGFILE" 2>/dev/null || true
    _tl_size="$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)"
    _tl_lines="$(wc -l < "$LOGFILE" 2>/dev/null || echo 0)"
    case "$_tl_size:$_tl_lines" in *[!0-9:]*) return 0 ;; esac
    if [ "$_tl_size" -gt 65536 ] || [ "$_tl_lines" -gt 200 ]; then
        _tl_tmp="${LOGFILE}.tmp.$$"
        tail -n 160 "$LOGFILE" > "$_tl_tmp" 2>/dev/null \
            && cat "$_tl_tmp" > "$LOGFILE" 2>/dev/null || true
        rm -f "$_tl_tmp"
    fi
}

case "${1:-start}" in
    start|restart)
        if [ "$ENABLED" != yes ]; then
            [ "${1:-start}" = restart ] && "$0" stop >/dev/null 2>&1 || true
            echo "trojan disabled — service is not started" >&2
            exit 0
        fi
        if ! key_config_ready; then
            [ "${1:-start}" = restart ] && "$0" stop >/dev/null 2>&1 || true
            echo "ключ не задан — сервис не запускается; добавьте ключ через бота или веб-панель" >&2
            exit 0
        fi
        ;;
esac

# A non-placeholder config can still be unusable (for example an old
# server-mode config that asks for a private key). Do not let rc.func report a
# false "started" state: retain the actual Trojan diagnostic and return an
# error so the fallback chain can try the next protocol.
if [ "${1:-start}" = start ] || [ "${1:-start}" = restart ]; then
    rotate_trojan_log
    _trojan_check="$(mktemp /tmp/keenzoo.trojan.check.XXXXXX 2>/dev/null || true)"
    if [ -n "$_trojan_check" ]; then
        if ! trojan -t -c "$CONFIG" >"$_trojan_check" 2>&1; then
            cat "$_trojan_check" >> "$LOGFILE" 2>/dev/null || true
            _trojan_tail="$(tail -12 "$_trojan_check" 2>/dev/null | tr '\n' ' ' \
                | sed 's/[[:space:]][[:space:]]*/ /g')"
            logger -t S22trojan "config check failed${_trojan_tail:+: $_trojan_tail}" \
                2>/dev/null || true
            [ "${1:-start}" = restart ] && "$0" stop >/dev/null 2>&1 || true
            echo "Trojan config не прошёл проверку" >&2
            cat "$_trojan_check" >&2
            rm -f "$_trojan_check"
            exit 1
        fi
        rm -f "$_trojan_check"
    fi
fi

. /opt/etc/init.d/rc.func
