#!/bin/sh

NAME="generator"
DESC="generator web panel"

PYTHON="/opt/bin/python3"
APP="/opt/etc/bot/generator.py"
WORKDIR="/opt/etc/bot"
PIDFILE="/opt/var/run/${NAME}.pid"
LOGFILE="/opt/etc/bot/generator.log"

export PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"
export PYTHONUNBUFFERED=1

is_running() {
    [ -f "$PIDFILE" ] || return 1
    PID="$(cat "$PIDFILE" 2>/dev/null || true)"
    [ -n "$PID" ] || return 1
    kill -0 "$PID" 2>/dev/null
}

start() {
    if is_running; then
        echo "$NAME already running (PID $(cat "$PIDFILE"))"
        return 0
    fi

    pkill -f '/opt/etc/bot/generator.py' 2>/dev/null || true
    rm -f "$PIDFILE"

    mkdir -p /opt/var/run /opt/etc/bot
    touch "$LOGFILE"

    echo -n "Starting $NAME... "

    cd "$WORKDIR" || {
        echo "FAILED: cannot cd $WORKDIR"
        return 1
    }

    nohup "$PYTHON" -u "$APP" >>"$LOGFILE" 2>&1 &
    PID="$!"
    echo "$PID" > "$PIDFILE"

    sleep 2

    if kill -0 "$PID" 2>/dev/null; then
        echo "OK (PID $PID)"
        return 0
    fi

    echo "FAILED"
    rm -f "$PIDFILE"
    echo "=== last log ==="
    tail -80 "$LOGFILE" 2>/dev/null
    return 1
}

stop() {
    echo -n "Stopping $NAME... "

    if is_running; then
        PID="$(cat "$PIDFILE")"
        kill "$PID" 2>/dev/null || true

        i=0
        while kill -0 "$PID" 2>/dev/null; do
            i=$((i + 1))
            [ "$i" -ge 10 ] && {
                kill -9 "$PID" 2>/dev/null || true
                break
            }
            sleep 1
        done
    fi

    pkill -f '/opt/etc/bot/generator.py' 2>/dev/null || true
    rm -f "$PIDFILE"

    echo "OK"
    return 0
}

status() {
    if is_running; then
        echo "$NAME is running (PID $(cat "$PIDFILE"))"
        return 0
    fi

    rm -f "$PIDFILE"

    PID="$(
        ps | awk '/python3 .*\/opt\/etc\/bot\/generator\.py/ {
            print $1
            exit
        }'
    )"

    if [ -n "$PID" ]; then
        echo "$NAME is running without pidfile (PID $PID)"
        echo "$PID" > "$PIDFILE"
        return 0
    fi

    echo "$NAME is not running"
    return 1
}

restart() {
    stop
    sleep 1
    start
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
