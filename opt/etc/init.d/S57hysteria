#!/bin/sh

ENABLED=yes
PROCS=hysteria
ARGS="client -c /opt/etc/hysteria/config.json"
PREARGS=""
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[ -z "$(which $PROCS)" ] && exit 0

# ── Порядок автозапуска ──────────────────────────────────────────────
# Скрипт называется S57, а не S23, намеренно: hysteria — Go-программа,
# она резолвит домен сервера через /etc/resolv.conf, где стоит
# nameserver 127.0.0.1, то есть через локальный dnsmasq (S56). Под
# прежним номером 23 резолвера ещё не существовало, домен не
# разрешался, и сервис молча завершался при каждой загрузке роутера.
#
# Ожидание внутри init-скрипта проблему не решало: Entware запускает
# S* последовательно одним циклом, поэтому пока S23 ждал бы dnsmasq,
# очередь до S56 просто не доходила — получалась взаимная блокировка.
# Единственно верное решение — стартовать после резолвера.
#
# Файл /opt/etc/hosts с закреплёнными адресами подключён к dnsmasq
# директивой addn-hosts, поэтому к моменту старта пин уже доступен.

# --log-level error: по умолчанию hysteria пишет info на каждое
# соединение, что переполняло журнал на накопителе с Entware.
# Вывод забирает rc.func (штатный файл Entware), поэтому отдельного
# лог-файла нет. Для разбора причины падения — запуск вручную:
#   hysteria client -c /opt/etc/hysteria/config.json --log-level info
ARGS="$ARGS --log-level error"

. /opt/etc/init.d/rc.func
