#!/bin/sh
# /opt/etc/init.d/S57hysteria
# Hysteria 2 transparent client for Keenetic/Entware BusyBox.
# The service is deliberately started here, after S56dnsmasq. Unlike the
# stock rc.func wrapper this keeps bounded stderr diagnostics and confirms the
# real TCP/UDP listener, not merely a short-lived PID.

ENABLED=yes
PROCS=hysteria
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=/opt/etc/hysteria/config.json
LOGFILE=/opt/var/log/hysteria.log

HYSTERIA_BIN="$(command -v hysteria 2>/dev/null || true)"
[ -n "$HYSTERIA_BIN" ] || exit 0

key_config_ready() {
    # A complete JSON can be a stale preserved config. Only a config written
    # through the key/config panel receives this explicit readiness marker.
    [ -f "/opt/etc/unblock/.configured/hysteria" ] || return 1
    [ -s "$CONFIG" ] || return 1
    grep -q '{{' "$CONFIG" 2>/dev/null && return 1
    grep -qE '"(address|server|remote_addr|password|auth|id|publicKey)"[[:space:]]*:[[:space:]]*(""|\[[[:space:]]*""|\[\])' "$CONFIG" 2>/dev/null && return 1
    return 0
}

# The generated config contains both tcpRedirect and udpTProxy listeners.
# Read the first configured listen port instead of hard-coding the current
# port, so a user's bot_config.py remains authoritative.
hysteria_port() {
    _hp="$(sed -n \
        's/.*"listen"[[:space:]]*:[[:space:]]*"[^:]*:\([0-9][0-9]*\)".*/\1/p' \
        "$CONFIG" 2>/dev/null | head -1)"
    case "$_hp" in ''|*[!0-9]*) _hp=10830 ;; esac
    printf '%s\n' "$_hp"
}

hysteria_listener_ready() {
    _hlr_port="$(hysteria_port)"
    _hlr_hex="$(printf '%04X' "$_hlr_port")"
    awk -v p=":$_hlr_hex" \
        'NR > 1 && index($2,p) == length($2)-length(p)+1 && $4 == "0A" {ok=1}
         END {exit !ok}' /proc/net/tcp /proc/net/tcp6 2>/dev/null \
        && return 0
    awk -v p=":$_hlr_hex" \
        'NR > 1 && index($2,p) == length($2)-length(p)+1 {ok=1}
         END {exit !ok}' /proc/net/udp /proc/net/udp6 2>/dev/null
}

rotate_hysteria_log() {
    mkdir -p /opt/var/log 2>/dev/null || true
    : >> "$LOGFILE" 2>/dev/null || true
    _hl_size="$(wc -c < "$LOGFILE" 2>/dev/null || echo 0)"
    _hl_lines="$(wc -l < "$LOGFILE" 2>/dev/null || echo 0)"
    case "$_hl_size:$_hl_lines" in
        *[!0-9:]* ) return 0 ;;
    esac
    if [ "$_hl_size" -gt 65536 ] || [ "$_hl_lines" -gt 200 ]; then
        _hl_tmp="${LOGFILE}.tmp.$$"
        tail -n 160 "$LOGFILE" > "$_hl_tmp" 2>/dev/null \
            && cat "$_hl_tmp" > "$LOGFILE" 2>/dev/null || true
        rm -f "$_hl_tmp"
    fi
}

log_hysteria_failure() {
    _lhf_reason="$1"
    _lhf_tail="$(tail -12 "$LOGFILE" 2>/dev/null | tr '\n' ' ' \
        | sed 's/[[:space:]][[:space:]]*/ /g')"
    logger -t S57hysteria \
        "start failed: $_lhf_reason${_lhf_tail:+; stderr=$_lhf_tail}" \
        2>/dev/null || true
    echo "hysteria: $_lhf_reason" >&2
    [ -n "$_lhf_tail" ] && echo "  stderr: $_lhf_tail" >&2
}

stop_hysteria() {
    printf 'Shutting down %s... ' "$DESC"
    killall "$PROCS" 2>/dev/null || true
    _hs=0
    while pidof "$PROCS" >/dev/null 2>&1 && [ "$_hs" -lt 10 ]; do
        sleep 1
        _hs=$((_hs + 1))
    done
    if pidof "$PROCS" >/dev/null 2>&1; then
        killall -9 "$PROCS" 2>/dev/null || true
    fi
    if pidof "$PROCS" >/dev/null 2>&1; then
        echo 'failed.'
        return 1
    fi
    echo 'done.'
    return 0
}

start_hysteria() {
    rotate_hysteria_log
    if pidof "$PROCS" >/dev/null 2>&1; then
        if hysteria_listener_ready; then
            echo "already running."
            return 0
        fi
        # A PID without a listener is a failed old instance. Do not let it
        # make DNS/netfilter believe that the Hysteria client is usable.
        killall "$PROCS" 2>/dev/null || true
        sleep 1
    fi

    printf 'Starting %s... ' "$DESC"
    (
        trap '' HUP
        exec "$HYSTERIA_BIN" client -c "$CONFIG" --log-level error
    ) >>"$LOGFILE" 2>&1 &
    _hpid="$!"
    _hw=0
    while [ "$_hw" -lt 12 ]; do
        if ! kill -0 "$_hpid" 2>/dev/null; then
            wait "$_hpid" 2>/dev/null || true
            echo 'failed.'
            log_hysteria_failure 'process exited before listener'
            return 1
        fi
        if hysteria_listener_ready; then
            echo 'done.'
            logger -t S57hysteria "started: listener port=$(hysteria_port)" \
                2>/dev/null || true
            return 0
        fi
        sleep 1
        _hw=$((_hw + 1))
    done

    echo 'failed.'
    log_hysteria_failure "listener $(hysteria_port) not ready"
    kill "$_hpid" 2>/dev/null || true
    sleep 1
    kill -9 "$_hpid" 2>/dev/null || true
    return 1
}

case "${1:-start}" in
    start|restart)
        if [ "$ENABLED" != yes ]; then
            [ "${1:-start}" = restart ] && stop_hysteria >/dev/null 2>&1 || true
            echo "hysteria disabled — service is not started" >&2
            exit 0
        fi
        if ! key_config_ready; then
            [ "${1:-start}" = restart ] && stop_hysteria >/dev/null 2>&1 || true
            echo "ключ не задан — сервис не запускается; добавьте ключ через бота или веб-панель" >&2
            exit 0
        fi
        ;;
    stop|kill|check|status|reconfigure) ;;
    *)
        echo "Usage: $0 {start|stop|restart|check|status|kill|reconfigure}" >&2
        exit 1
        ;;
esac

case "${1:-start}" in
    start)
        start_hysteria
        ;;
    restart)
        stop_hysteria >/dev/null 2>&1 || true
        start_hysteria
        ;;
    stop)
        stop_hysteria
        ;;
    kill)
        killall -9 "$PROCS" 2>/dev/null || true
        ;;
    check|status)
        if pidof "$PROCS" >/dev/null 2>&1 && hysteria_listener_ready; then
            echo "$DESC is running (process + listener ready)"
            exit 0
        fi
        echo "$DESC is not ready"
        exit 1
        ;;
    reconfigure)
        killall -HUP "$PROCS" 2>/dev/null || true
        ;;
esac
