#!/bin/sh
# Tor запускается после локального dnsmasq: на Keenetic init.d вызывается
# лексикографически, поэтому S35tor раньше S56dnsmasq. Если DNS ещё не
# поднят, откладываем только старт Tor, не блокируя загрузку прошивки.

ENABLED=yes
PROCS=tor
ARGS="-f /opt/etc/tor/torrc"
PREARGS=""
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TOR_WAIT_LOCK="/tmp/keenzoo-tor-wait.lockdir"
TOR_WAIT_MAX=30

tor_dns_ready() {
    if command -v pidof >/dev/null 2>&1; then
        pidof dnsmasq >/dev/null 2>&1 && return 0
    fi
    ps 2>/dev/null | grep -q '[d]nsmasq' && return 0
    return 1
}

if [ "${1:-}" = "start" ] && [ "${KEENZOO_TOR_DEFERRED:-0}" != "1" ]; then
    if ! tor_dns_ready; then
        if mkdir "$TOR_WAIT_LOCK" 2>/dev/null; then
            (
                _tor_wait=0
                while [ "$_tor_wait" -lt "$TOR_WAIT_MAX" ]; do
                    tor_dns_ready && break
                    sleep 1
                    _tor_wait=$((_tor_wait + 1))
                done
                rm -rf "$TOR_WAIT_LOCK" 2>/dev/null || true
                KEENZOO_TOR_DEFERRED=1 "$0" start >/dev/null 2>&1 || \
                    logger -t S35tor "отложенный запуск Tor завершился ошибкой"
            ) >/dev/null 2>&1 </dev/null &
        fi
        exit 0
    fi
fi

# Проверка не заменяет запуск через rc.func, но позволяет получить
# понятную ошибку до появления неработающего процесса и правил Tor.
TOR_BIN="$(command -v tor 2>/dev/null || true)"
if [ "${1:-}" = "start" ] && [ -n "$TOR_BIN" ] && \
    [ -f /opt/etc/tor/torrc ]; then
    if ! "$TOR_BIN" --verify-config -f /opt/etc/tor/torrc \
        >/dev/null 2>&1; then
        logger -t S35tor "torrc не прошёл tor --verify-config"
        exit 1
    fi
fi

. /opt/etc/init.d/rc.func
