#!/bin/sh
# remove leaves init files for backup; block future starts, not stop/status.
if [ -f /opt/etc/unblock/.disabled ]; then
    case "${1:-start}" in start|restart|reconfigure|reload) exit 0 ;; esac
fi
# Tor запускается после локального dnsmasq: на Keenetic init.d вызывается
# лексикографически, поэтому S35tor раньше S56dnsmasq. Если DNS ещё не
# поднят, откладываем только старт Tor, не блокируя загрузку прошивки.

ENABLED=yes
PROCS=tor
ARGS="-f /opt/etc/tor/torrc"
PREARGS=""
DESC=$PROCS
PATH=/opt/sbin:/opt/bin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TOR_WAIT_LOCK="/tmp/keenzoo-tor-wait.lockdir"
TOR_WAIT_MAX=30
TOR_WAIT_STALE=90

tor_lock_live() {
    _tll_pid="$(cat "$TOR_WAIT_LOCK/pid" 2>/dev/null || true)"
    _tll_saved="$(cat "$TOR_WAIT_LOCK/start" 2>/dev/null || true)"
    case "$_tll_pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$_tll_pid" 2>/dev/null || return 1
    case "$_tll_saved" in ''|*[!0-9]*) return 1 ;; esac
    _tll_now="$(awk '{print $22}' "/proc/$_tll_pid/stat" 2>/dev/null || true)"
    [ -n "$_tll_now" ] && [ "$_tll_now" = "$_tll_saved" ]
}

tor_lock_age() {
    _tla_mtime="$(stat -c %Y "$TOR_WAIT_LOCK" 2>/dev/null || echo 0)"
    _tla_now="$(date +%s 2>/dev/null || echo 0)"
    case "$_tla_mtime:$_tla_now" in
        *[!0-9:]*|0:*) return 1 ;;
    esac
    [ $((_tla_now - _tla_mtime)) -ge 0 ] || return 1
    printf '%s\n' $((_tla_now - _tla_mtime))
}

tor_dns_ready() {
    if command -v pidof >/dev/null 2>&1; then
        pidof dnsmasq >/dev/null 2>&1 && return 0
    fi
    ps 2>/dev/null | grep -q '[d]nsmasq' && return 0
    return 1
}

if [ "${1:-}" = "start" ] && [ "${KEENZOO_TOR_DEFERRED:-0}" != "1" ]; then
    if ! tor_dns_ready; then
        # mkdir is atomic. A lock with a live owner and matching /proc start
        # time belongs to another deferred worker; kill -0 alone is not enough
        # because PID reuse could make an old directory look current.
        if [ -d "$TOR_WAIT_LOCK" ]; then
            if tor_lock_live; then
                exit 0
            fi
            _tor_lock_age="$(tor_lock_age || true)"
            case "$_tor_lock_age" in
                ''|*[!0-9]*) exit 0 ;;
                *) [ "$_tor_lock_age" -ge "$TOR_WAIT_STALE" ] || exit 0 ;;
            esac
            rm -rf "$TOR_WAIT_LOCK" 2>/dev/null || exit 0
        fi

        if mkdir "$TOR_WAIT_LOCK" 2>/dev/null; then
            (
                trap 'rm -rf "$TOR_WAIT_LOCK" 2>/dev/null || true' EXIT
                trap 'exit 130' INT
                trap 'exit 143' TERM
                trap 'exit 129' HUP
                _tor_wait=0
                while [ "$_tor_wait" -lt "$TOR_WAIT_MAX" ]; do
                    tor_dns_ready && break
                    sleep 1
                    _tor_wait=$((_tor_wait + 1))
                done
                KEENZOO_TOR_DEFERRED=1 "$0" start >/dev/null 2>&1 || \
                    logger -t S35tor "отложенный запуск Tor завершился ошибкой"
            ) >/dev/null 2>&1 </dev/null &
            _tor_wait_pid="$!"
            printf '%s\n' "$_tor_wait_pid" > "$TOR_WAIT_LOCK/pid"
            awk '{print $22}' "/proc/$_tor_wait_pid/stat" \
                2>/dev/null > "$TOR_WAIT_LOCK/start" || true
            date +%s > "$TOR_WAIT_LOCK/ts" 2>/dev/null || true
        fi
        exit 0
    fi
fi

# Проверка не заменяет запуск через rc.func, но позволяет получить
# понятную ошибку до появления неработающего процесса и правил Tor.
TOR_BIN="$(command -v tor 2>/dev/null || true)"
if [ "${1:-}" = "start" ] && [ -n "$TOR_BIN" ] && \
    [ -f /opt/etc/tor/torrc ]; then
    if ! "$TOR_BIN" --verify-config -f /opt/etc/tor/torrc \
        >/dev/null 2>&1; then
        logger -t S35tor "torrc не прошёл tor --verify-config"
        exit 1
    fi
fi

. /opt/etc/init.d/rc.func
