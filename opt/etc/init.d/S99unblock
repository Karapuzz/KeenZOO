#!/bin/sh
# Existing entrypoint now owns the v4 resolver service lifecycle.
set -eu
PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH
# dns4.2.30 (полный аудит, П2): паритет с S99generator — интерпретатор
# ищем по тем же путям. Голый «python3» пропускает версионированные
# сборки без симлинка (только python3.11/3.12/3.13): контроллер тогда
# молча не стартует, а панель работает. Дубль 8 строк осознан —
# общий lib менял бы структуру проекта (прецедент: _stop_project_xray).
find_python() {
    for _p in /opt/bin/python3 /usr/bin/python3 /opt/bin/python3.11 \
              /opt/bin/python3.12 /opt/bin/python3.13; do
        [ -x "$_p" ] && { printf '%s\n' "$_p"; return 0; }
    done
    _p="$(command -v python3 2>/dev/null || true)"
    [ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }
    return 1
}
# Худший случай ровно прежний: голый «python3».
KZ_PY="$(find_python || echo python3)"
case "${1:-}" in
    stop|dns-stop) "$KZ_PY" /opt/etc/bot/utils.py --dns-stop; exit $? ;;
esac
[ ! -f /opt/etc/unblock/.disabled ] || exit 0
# Cron/init must not race an installer copying code. Deploy starts utils directly.
[ ! -f /tmp/keenzoo_installing ] || exit 0
case "${1:-}" in
    dns-start) exec "$KZ_PY" /opt/etc/bot/utils.py --dns-start ;;
    dns-event)
        # Event notification, not a periodic process/probe launcher.
        "$KZ_PY" /opt/etc/bot/utils.py --dns-event && exit 0
        exec "$KZ_PY" /opt/etc/bot/utils.py --dns-start
        ;;
    dns-status|status) exec "$KZ_PY" /opt/etc/bot/utils.py --dns-status ;;
    dns-restart)
        "$KZ_PY" /opt/etc/bot/utils.py --dns-stop
        exec "$KZ_PY" /opt/etc/bot/utils.py --dns-start
        ;;
    start|restart)
        if [ "$1" = restart ]; then "$KZ_PY" /opt/etc/bot/utils.py --dns-stop; fi
        "$KZ_PY" /opt/etc/bot/utils.py --dns-start
        [ -x /opt/bin/unblock_update.sh ] || exit 0
        (trap '' HUP; exec /opt/bin/unblock_update.sh) >/dev/null 2>&1 </dev/null &
        ;;
    *) echo "Usage: $0 {start|stop|restart|dns-start|dns-restart|dns-event|dns-status}" >&2; exit 2 ;;
esac
