#!/bin/sh
# remove leaves init files for backup; block future starts, not stop/status.
if [ -f /opt/etc/unblock/.disabled ]; then
    case "${1:-start}" in start|restart|reconfigure|reload) exit 0 ;; esac
fi

BOT_DIR="/opt/etc/bot"
MAIN_SCRIPT="$BOT_DIR/main.py"
LOG_FILE="$BOT_DIR/error.log"
PATH="/opt/bin:/opt/sbin:/opt/usr/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"
export PATH

# Не писать .pyc рядом с исходниками: /opt лежит на USB-накопителе, и
# перезапись кэша при каждом импорте изнашивает флешку без пользы.
export PYTHONDONTWRITEBYTECODE=1

# dns4.2.31 (полный аудит, остаточное наблюдение): паритет с
# S99generator/S99unblock — интерпретатор ищем по тем же путям.
# Голый «python3» пропускает версионированные сборки без симлинка
# (только python3.11/3.12/3.13): вызов тогда молча не срабатывает.
# Дубль 8 строк осознан — общий lib менял бы структуру проекта.
find_python() {
    for _p in /opt/bin/python3 /usr/bin/python3 /opt/bin/python3.11 \
              /opt/bin/python3.12 /opt/bin/python3.13; do
        [ -x "$_p" ] && { printf '%s\n' "$_p"; return 0; }
    done
    _p="$(command -v python3 2>/dev/null || true)"
    [ -n "$_p" ] && { printf '%s\n' "$_p"; return 0; }
    return 1
}
# Худший случай ровно прежний: голый «python3».
KZ_PY="$(find_python || echo python3)"

if [ ! -d "$BOT_DIR" ] || [ ! -f "$MAIN_SCRIPT" ]; then
    echo "Error: Bot directory or main.py not found"
    exit 1
fi

# Возвращает PID только реально запущенного python-процесса, у которого
# отдельным argv является MAIN_SCRIPT.
#
# Нельзя использовать pgrep -f: на некоторых сборках BusyBox он выдаёт
# ложное совпадение для команды поиска/обёртки init-скрипта. Из-за этого
# start сообщал "Bot is already running", хотя в /proc бота не было.
# Проверка argv0 и argv через /proc не зависит от наличия pgrep и не
# совпадает с самим поисковым процессом.
check_process() {
    for _cp_d in /proc/[0-9]*; do
        [ -r "$_cp_d/cmdline" ] || continue

        _cp_argv="$(cat "$_cp_d/cmdline" 2>/dev/null | tr '\0' '\n')"
        _cp_argv0="$(printf '%s\n' "$_cp_argv" | sed -n '1p')"
        case "${_cp_argv0##*/}" in
            python|python3|python3.*) ;;
            *) continue ;;
        esac

        if printf '%s\n' "$_cp_argv" | grep -Fqx "$MAIN_SCRIPT"; then
            _cp_pid="${_cp_d#/proc/}"
            [ "$_cp_pid" = "$$" ] && continue
            printf '%s\n' "$_cp_pid"
        fi
    done
}

log_writable() {
    # Редирект в background-команде выполняет shell до запуска Python.
    # Проверяем его заранее, чтобы причина не терялась в сообщении start.
    if : >> "$LOG_FILE" 2>/dev/null; then
        return 0
    fi
    echo "Error: cannot write $LOG_FILE"
    return 1
}

# NDM может оставить /etc/resolv.conf только с options или перезаписать
# его после загрузки. Бот использует системный resolver Python, поэтому
# перед запуском ставим локальный dnsmasq первым nameserver. Используется
# существующий системный файл, отдельный постоянный файл не создаётся.
ensure_local_resolver() {
    [ -e /etc/resolv.conf ] || : > /etc/resolv.conf 2>/dev/null || return 1
    [ -w /etc/resolv.conf ] || return 1

    _elr_tmp="$(mktemp /tmp/keenzoo_bot_resolv.XXXXXX 2>/dev/null || true)"
    [ -n "$_elr_tmp" ] || return 1

    if {
        printf 'nameserver 127.0.0.1\n'
        sed '/^[[:space:]]*nameserver[[:space:]]*127\.0\.0\.1[[:space:]]*$/d' \
            /etc/resolv.conf 2>/dev/null
    } > "$_elr_tmp" 2>/dev/null \
        && cat "$_elr_tmp" > /etc/resolv.conf 2>/dev/null
    then
        rm -f "$_elr_tmp"
        return 0
    fi

    rm -f "$_elr_tmp"
    return 1
}

case "$1" in
    start)
        if ! ensure_local_resolver; then
            echo "Warning: cannot set nameserver 127.0.0.1 in /etc/resolv.conf"
        fi
        _bot_pids="$(check_process)"
        if [ -n "$_bot_pids" ]; then
            echo "Bot is already running (PID: $(printf '%s' "$_bot_pids" | tr '\n' ' '))"
            exit 0
        fi

        rm -rf "$BOT_DIR/__pycache__" 2>/dev/null || true
        log_writable || exit 1

        "$KZ_PY" "$MAIN_SCRIPT" >> "$LOG_FILE" 2>&1 &
        _bot_start_pid=$!
        sleep 2

        _bot_pids="$(check_process)"
        if [ -n "$_bot_pids" ]; then
            echo "Bot started successfully (PID: $(printf '%s' "$_bot_pids" | tr '\n' ' '))"
            exit 0
        fi

        echo "Error: Bot failed to start (launch PID: $_bot_start_pid)"
        tail -20 "$LOG_FILE" 2>/dev/null || true
        exit 1
        ;;

    stop)
        _bot_pids="$(check_process)"
        if [ -z "$_bot_pids" ]; then
            echo "Bot is not running"
            exit 0
        fi

        for _bot_pid in $_bot_pids; do
            kill "$_bot_pid" 2>/dev/null || true
        done
        sleep 2

        _bot_pids="$(check_process)"
        if [ -n "$_bot_pids" ]; then
            for _bot_pid in $_bot_pids; do
                kill -9 "$_bot_pid" 2>/dev/null || true
            done
            sleep 1
            if [ -n "$(check_process)" ]; then
                echo "Error: Bot failed to stop even with SIGKILL"
                exit 1
            fi
            echo "Bot stopped successfully (forced with SIGKILL)"
            exit 0
        fi

        echo "Bot stopped successfully"
        exit 0
        ;;

    restart)
        "$0" stop || exit $?
        sleep 1
        exec "$0" start
        ;;

    status)
        _bot_pids="$(check_process)"
        if [ -n "$_bot_pids" ]; then
            echo "Bot is running (PID: $(printf '%s' "$_bot_pids" | tr '\n' ' '))"
            exit 0
        fi
        echo "Bot is stopped"
        exit 0
        ;;

    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
