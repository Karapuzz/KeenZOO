#!/bin/sh

BOT_DIR="/opt/etc/bot"
MAIN_SCRIPT="$BOT_DIR/main.py"
LOG_FILE="$BOT_DIR/error.log"

# Не писать .pyc рядом с исходниками: /opt лежит на USB-накопителе, и
# перезапись кэша при каждом импорте изнашивает флешку без пользы —
# модули всё равно читаются один раз за старт. Заодно снимает давнюю
# проблему устаревшего __pycache__, подменявшего правленый bot_config.py.
export PYTHONDONTWRITEBYTECODE=1

# Проверка существования директории и скрипта
if [ ! -d "$BOT_DIR" ] || [ ! -f "$MAIN_SCRIPT" ]; then
    echo "Error: Bot directory or main.py not found"
    exit 1
fi

# Функция проверки процесса, возвращает PID или пустую строку.
#
# pgrep есть не во всех сборках BusyBox прошивки Keenetic (в S99generator
# по этой же причине сделан фолбэк для pkill). Без запасного варианта
# отсутствие апплета означало бы «бот всегда не запущен»: status врал бы,
# stop не находил процесс, а start плодил второй экземпляр.
check_process() {
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -f "python3 $MAIN_SCRIPT"
        return 0
    fi
    # Разбор /proc без внешних утилит. Читаем через cat: процесс может
    # исчезнуть между раскрытием маски и открытием файла, а сообщение
    # оболочки о неудачном перенаправлении "< файл" не подавляется
    # через 2>/dev/null у самой команды и засоряет журнал.
    for _cp_d in /proc/[0-9]*; do
        _cp_cmd="$(cat "$_cp_d/cmdline" 2>/dev/null | tr '\0' ' ')"
        case "$_cp_cmd" in
            *python3*"$MAIN_SCRIPT"*)
                _cp_pid="${_cp_d#/proc/}"
                [ "$_cp_pid" = "$$" ] && continue
                echo "$_cp_pid"
                ;;
        esac
    done
}

case "$1" in
    start)
        if check_process > /dev/null; then
            echo "Bot is already running"
            exit 0
        fi
        
        # Устаревший __pycache__ от прежней версии подменяет модуль:
        # bot_config.py правится, а бот читает старые значения.
        rm -rf "$BOT_DIR/__pycache__" 2>/dev/null || true
        python3 "$MAIN_SCRIPT" >> "$LOG_FILE" 2>&1 &
        pid=$!
        sleep 2
        
        if check_process > /dev/null; then
            echo "Bot started successfully (PID: $pid)"
            exit 0
        else
            echo "Error: Bot failed to start"
            exit 1
        fi
        ;;
	stop)
        pid=$(check_process)
        if [ -n "$pid" ]; then
            kill "$pid"
            sleep 2
            if check_process > /dev/null; then
                kill -9 "$pid"
                sleep 1
                if check_process > /dev/null; then
                    echo "Error: Bot failed to stop even with SIGKILL"
                    exit 1
                else
                    echo "Bot stopped successfully (forced with SIGKILL)"
                    exit 0
                fi
            else
                echo "Bot stopped successfully"
                exit 0
            fi
        else
            echo "Bot is not running"
            exit 0
        fi
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        pid=$(check_process)
        if [ -n "$pid" ]; then
            echo "Bot is running (PID: $pid)"
            exit 0
        else
            echo "Bot is stopped"
            exit 0
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
