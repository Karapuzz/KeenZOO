{
  "log": {
    "access": "none",
    "error": "",
    "loglevel": "error"
  },
  "routing": {
    "domainMatcher": "hybrid",
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "network": "udp,tcp",
        "port": "0-65535",
        "outboundTag": "proxy"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "vless-tcp-redirect",
      "port": 10810,
      "listen": "0.0.0.0",
      "protocol": "dokodemo-door",
      "settings": {
        "network": "tcp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "redirect"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    },
    {
      "tag": "vless-udp-tproxy",
      "port": 10810,
      "listen": "0.0.0.0",
      "protocol": "dokodemo-door",
      "settings": {
        "network": "udp",
        "followRedirect": true
      },
      "streamSettings": {
        "sockopt": {
          "tproxy": "tproxy"
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "quic"
        ]
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "mux": {
        "enabled": true,
        "concurrency": -1,
        "xudpConcurrency": 8,
        "xudpProxyUDP443": "allow"
      },
      "settings": {
        "vnext": [
          {
            "address": "{{address}}",
            "port": 443,
            "users": [
              {
                "id": "{{id}}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "tcpSettings": {
          "header": {
            "type": "none"
          }
        },
        "security": "reality",
        "realitySettings": {
          "serverName": "{{sni}}",
          "publicKey": "{{pbk}}",
          "shortId": "{{sid}}",
          "fingerprint": "firefox"
        },
        "sockopt": {
          "mark": 33554432
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom",
      "streamSettings": {
        "sockopt": {
          "mark": 33554432
        }
      }
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "remarks": ""
}
