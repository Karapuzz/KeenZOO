  "server": "{{server}}",
  "auth": "{{auth}}",
  "tls": {
    "sni": "{{sni}}",
    "insecure": false,
    "alpn": [
      "h3"
    ]
  },
  "quic": {
    "initStreamReceiveWindow": 8388608,
