{
    "log":{
        "access":"",
        "error":"",
        "loglevel":"none"
    },
    "inbounds":[
    {
        "tag":"vless-tcp-redirect",
        "port":{{localportvless}},
        "listen":"0.0.0.0",
        "protocol":"dokodemo-door",
        "settings":{
    "network":"tcp",
    "followRedirect":true
        },
        "streamSettings":{
    "sockopt":{
        "tproxy":"redirect"
    }
        },
        "sniffing":{
    "enabled":true,
    "destOverride":[
        "http",
        "tls",
        "quic"
    ]
        }
    },
    {
        "tag":"vless-udp-tproxy",
        "port":{{localportvless}},
        "listen":"0.0.0.0",
        "protocol":"dokodemo-door",
        "settings":{
    "network":"udp",
    "followRedirect":true
        },
        "streamSettings":{
    "sockopt":{
        "tproxy":"tproxy"
    }
        },
        "sniffing":{
    "enabled":true,
    "destOverride":[
        "quic"
    ]
        }
    }
    ],
    "outbounds":[
    {
        "tag":"vless-reality",
        "protocol":"vless",
        "mux":{
    "enabled":true,
    "concurrency":-1,
    "xudpConcurrency":8,
    "xudpProxyUDP443":"allow"
        },
        "settings":{
    "vnext":[
        {
        "address":"{{address}}",
        "port":{{port}},
        "users":[
            {
	"id":"{{id}}",
	"flow":"{{flow}}",
	"encryption":"{{encryption}}",
	"level":0
            }
        ]
        }
    ]
        },
        "streamSettings":{
    "network":"{{transport}}",
    "security":"{{security}}",
    "sockopt":{
        "mark":33554432
    },
    "realitySettings":{
        "publicKey":"{{pbk}}",
        "fingerprint":"{{fp}}",
        "serverName":"{{sni}}",
        "shortId":"{{sid}}",
        "spiderX":"{{spx}}"
    },
    "tlsSettings":{
        "serverName":"{{sni}}",
        "allowInsecure":false
    },
    "tcpSettings":{
    },
    "grpcSettings":{
        "serviceName":"{{serviceName}}"
    },
    "wsSettings":{
        "path":"{{ws_path}}",
        "headers":{
        "Host":"{{ws_host}}"
        }
    },
    "xhttpSettings":{
        "mode":"{{xhttp_mode}}",
        "path":"{{xhttp_path}}",
        "host":"{{xhttp_host}}"
    }
        }
    },
    {
        "tag":"direct",
        "protocol":"freedom"
    },
    {
        "tag":"block",
        "protocol":"blackhole",
        "settings":{
    "response":{
        "type":"http"
    }
        }
    }
    ],
    "routing":{
    "domainStrategy":"IPIfNonMatch",
    "rules":[
        {
    "type":"field",
    "network":"udp,tcp",
    "port":"0-65535",
    "outboundTag":"vless-reality",
    "enabled":true
        }
    ]
    }
}
