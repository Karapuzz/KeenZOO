{
  "server": "{{server}}:{{port}}",
  "auth": "{{auth}}",
  "lazy": true,
  "tls": {
    "sni": "{{sni}}",
    "insecure": {{insecure}},
    "alpn": [{{alpn}}]
  },
  "obfs": {
    "type": "{{obfs_type}}",
    "salamander": {
      "password": "{{obfs_password}}"
    }
  },
  "quic": {
    "initStreamReceiveWindow": 8388608,
    "maxStreamReceiveWindow": 8388608,
    "initConnReceiveWindow": 20971520,
    "maxConnReceiveWindow": 20971520,
    "keepAlivePeriod": "10s",
    "maxIdleTimeout": "30s"
  },
  "tcpRedirect": {
    "listen": "0.0.0.0:{{localporthysteria}}"
  },
  "udpTProxy": {
    "listen": "0.0.0.0:{{localporthysteria}}",
    "timeout": "60s"
  }
}
