{
  "log_level": 3,
  "run_type": "nat",
  "local_addr": "0.0.0.0",
  "local_port": {{localporttrojan}},
  "remote_addr": "{{host}}",
  "remote_port": {{port}},
  "password": ["{{pw}}"],
  "udp_timeout": 60,
  "ssl": {
    "verify": {{verify}},
    "verify_hostname": true,
    "sni": "{{sni}}",
    "alpn": [{{alpn}}],
    "fingerprint": "{{fp}}"
  },
  "websocket": {
    "enabled": {{ws_enabled}},
    "path": "{{path}}",
    "host": "{{host_header}}"
  }
}
